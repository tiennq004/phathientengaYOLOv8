# Sao chép thành file .env và điền giá trị (không commit file .env).
# Gmail: Tài khoản Google > Bảo mật > Mật khẩu ứng dụng (16 ký tự, gộp không khoảng trắng).

SECRET_KEY=doi-chuoi-bi-mat-ngau-nhien-o-day

# Đăng nhập web (đổi mật khẩu khi triển khai thật)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
USER_USERNAME=user
USER_PASSWORD=user123

SMTP_USER=
SMTP_APP_PASSWORD=
ALERT_TO_EMAIL=tjennguyen2004@gmail.com

# Camera Imou Life (RTSP — máy chạy web_app phải cùng mạng LAN với camera)
# Bật RTSP trong app Imou Life: Cài đặt thiết bị > Mạng / Nâng cao > RTSP
IMOU_IP=192.168.1.100
IMOU_USER=admin
IMOU_PASSWORD=
IMOU_RTSP_PORT=554
IMOU_CHANNEL=1
# 0 = luồng chính HD, 1 = luồng phụ (nhẹ, khuyến nghị)
IMOU_SUBTYPE=1
# Hoặc dán URL đầy đủ (ưu tiên hơn các biến trên):
# IMOU_RTSP_URL=rtsp://admin:matkhau@192.168.1.100:554/cam/realmonitor?channel=1&subtype=1
